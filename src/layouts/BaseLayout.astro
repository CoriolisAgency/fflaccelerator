---
import "../styles/global.css";
import AccelEmailCapture from "../components/AccelEmailCapture.astro";
import SiteChrome from "../components/SiteChrome.astro";
import { SITE, CANON_PATHS } from "../lib/site";
import { LINKS, SAME_AS } from "../lib/links";
import { withBase } from "../lib/base";
import type { FaqItem } from "../lib/faq";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  /** Path under public/, no leading slash */
  ogImagePath?: string;
  /** Absolute override when the constructed URL is not enough. */
  canonicalUrl?: string;
  faq?: FaqItem[];
  /** Email capture modal. Off for confirm. @default true */
  emailCapture?: boolean;
}

const {
  title = SITE.titleDefault,
  description = SITE.description,
  path = "/",
  ogImagePath = CANON_PATHS.headshot,
  canonicalUrl,
  faq,
  emailCapture = true,
} = Astro.props;

const siteOrigin = Astro.site ?? new URL("https://fflaccelerator.com");
const pagePath = path === "/" ? "/" : withBase(path);
const canonical = canonicalUrl ?? new URL(pagePath, siteOrigin).href;
const ogAbs = new URL(withBase(ogImagePath), siteOrigin).href;

const graph: Record<string, unknown>[] = [
  {
    "@type": "Organization",
    "@id": `${LINKS.home}/#organization`,
    name: "Coriolis, LLC",
    legalName: SITE.legalName,
    alternateName: ["Coriolis Agency", "FFL Accelerator"],
    url: LINKS.coriolis,
    description: SITE.description,
    sameAs: [...SAME_AS],
    address: {
      "@type": "PostalAddress",
      addressLocality: "Greenville",
      addressRegion: "SC",
      addressCountry: "US",
    },
  },
  {
    "@type": "WebSite",
    "@id": `${LINKS.home}/#website`,
    url: LINKS.home,
    name: SITE.name,
    description: SITE.description,
    publisher: { "@id": `${LINKS.home}/#organization` },
  },
  {
    "@type": "WebPage",
    "@id": `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    isPartOf: { "@id": `${LINKS.home}/#website` },
  },
];

if (faq?.length) {
  graph.push({
    "@type": "FAQPage",
    "@id": `${canonical}#faq`,
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.a,
      },
    })),
  });
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": graph,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a1220" />
    <link rel="icon" type="image/png" href={withBase(CANON_PATHS.icon)} />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={withBase("favicon-32.png")}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="48x48"
      href={withBase("favicon-48.png")}
    />
    <link rel="apple-touch-icon" href={withBase("apple-touch-icon.png")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogAbs} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@2ABetsy" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogAbs} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="min-h-dvh flex flex-col">
    <SiteChrome>
      <slot />
    </SiteChrome>
    {emailCapture ? <AccelEmailCapture /> : null}
  </body>
</html>
