---
import "../styles/global.css";
import AccelEmailCapture from "../components/AccelEmailCapture.astro";
import SiteChrome from "../components/SiteChrome.astro";
import UtmCapture from "@coriolis/lead-form/UtmCapture.astro";
import { SITE, SITE_ORIGIN, CANON_PATHS } from "../lib/site";
import { withBase } from "../lib/base";
import type { FaqItem } from "../lib/faq";

interface Props {
  title?: string;
  description?: string;
  path?: string;
  /** Path under public/, no leading slash */
  ogImagePath?: string;
  /** Absolute override when the constructed URL is not enough. */
  canonicalUrl?: string;
  faq?: FaqItem[];
  /** Email capture modal. Off for confirm and contact. @default true */
  emailCapture?: boolean;
  noindex?: boolean;
}

const {
  title = SITE.titleDefault,
  description = SITE.description,
  path = "/",
  ogImagePath = CANON_PATHS.logo,
  canonicalUrl,
  faq,
  emailCapture = true,
  noindex = false,
} = Astro.props;

const gaId = import.meta.env.PUBLIC_GA4_ID;

const siteOrigin = Astro.site ?? new URL(SITE_ORIGIN);
const pagePath = path === "/" ? "/" : withBase(path);
const canonical = canonicalUrl ?? new URL(pagePath, siteOrigin).href;
const ogAbs = new URL(withBase(ogImagePath), siteOrigin).href;

const graph: Record<string, unknown>[] = [
  {
    "@type": "Organization",
    "@id": `${SITE_ORIGIN}/#organization`,
    name: "Coriolis, LLC",
    legalName: SITE.legalName,
    alternateName: ["Coriolis Agency", "FFL Accelerator"],
    url: SITE_ORIGIN,
    description: SITE.description,
    telephone: "+1-828-290-9005",
    address: {
      "@type": "PostalAddress",
      streetAddress: SITE.street,
      addressLocality: SITE.locality,
      addressRegion: SITE.region,
      postalCode: SITE.postal,
      addressCountry: "US",
    },
  },
  {
    "@type": "WebSite",
    "@id": `${SITE_ORIGIN}/#website`,
    url: SITE_ORIGIN,
    name: SITE.name,
    description: SITE.description,
    publisher: { "@id": `${SITE_ORIGIN}/#organization` },
  },
  {
    "@type": "WebPage",
    "@id": `${canonical}#webpage`,
    url: canonical,
    name: title,
    description,
    isPartOf: { "@id": `${SITE_ORIGIN}/#website` },
  },
];

if (faq?.length) {
  graph.push({
    "@type": "FAQPage",
    "@id": `${canonical}#faq`,
    mainEntity: faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: {
        "@type": "Answer",
        text: item.a,
      },
    })),
  });
}

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": graph,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0a1220" />
    <link rel="icon" type="image/png" href={withBase(CANON_PATHS.icon)} />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href={withBase("favicon-32.png")}
    />
    <link
      rel="icon"
      type="image/png"
      sizes="48x48"
      href={withBase("favicon-48.png")}
    />
    <link rel="apple-touch-icon" href={withBase("apple-touch-icon.png")} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogAbs} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogAbs} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <UtmCapture />
    {
      gaId ? (
        <>
          <script
            async
            src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
            is:inline
          />
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag("js", new Date());
            gtag("config", gaId);
          </script>
          <script is:inline>
            (function () {
              function arm(form) {
                var status = form.querySelector("[data-lf-status]");
                if (!status || status.dataset.lfGaArmed === "1") return;
                status.dataset.lfGaArmed = "1";
                var sent = false;
                new MutationObserver(function () {
                  if (sent) return;
                  if (status.classList.contains("lf-status-ok")) {
                    sent = true;
                    if (typeof window.gtag === "function") {
                      window.gtag("event", "generate_lead", {
                        method: "contact_form",
                      });
                    }
                  }
                }).observe(status, {
                  attributes: true,
                  attributeFilter: ["class"],
                });
              }
              function scan() {
                document.querySelectorAll("form[data-lf-form]").forEach(arm);
              }
              if (document.readyState === "loading") {
                document.addEventListener("DOMContentLoaded", scan);
              } else {
                scan();
              }
            })();
          </script>
        </>
      ) : null
    }
  </head>
  <body class="min-h-dvh flex flex-col">
    <SiteChrome>
      <slot />
    </SiteChrome>
    {emailCapture ? <AccelEmailCapture /> : null}
  </body>
</html>
