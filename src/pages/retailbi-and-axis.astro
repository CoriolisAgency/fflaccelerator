---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import CommercialLine from "../components/CommercialLine.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { FAQ_RETAILBI } from "../lib/faq";
import { FROZEN } from "../lib/frozen";
import { LINKS, linkClass, btnSecondary } from "../lib/links";
---

<BaseLayout
  title="You Feed RetailBI via AXIS. Your Website Is Still Dark. | FFL Accelerator"
  description="AXIS can feed RetailBI at the register. Your website is still dark unless a demand sensor is on it. FFL Accelerator ($569/mo) is the managed path. Free GSA is the self-serve path. We do not ask anyone to leave RetailBI."
  path="/retailbi-and-axis"
  faq={FAQ_RETAILBI}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto max-w-6xl px-4">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.18em] text-sky-400"
      >
        For AXIS / RetailBI retailers
      </p>
      <h1 class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-white sm:text-4xl">
        You already feed RetailBI. Your website is still dark.
      </h1>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-zinc-300">
        If your gun store runs AXIS and reports into RetailBI, the register
        series is lit. The public site usually is not. Shoppers type SKUs,
        calibers, and “do you have…” on a page with no sensor. FFL Accelerator
        is the managed WooCommerce path that puts Betsy on a site you own.
        {FROZEN.commercialLine}
      </p>
      <div class="mt-8">
        <CtaRow />
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-6xl px-4 space-y-4">
      <h2 class="text-xl font-semibold text-white">Two different numbers</h2>
      <p class="max-w-2xl text-sm leading-relaxed text-zinc-400">
        {FROZEN.retailBi}
      </p>
      <p class="max-w-2xl text-sm leading-relaxed text-zinc-400">
        {FROZEN.retailBiIndex}
      </p>
      <p class="max-w-2xl text-sm leading-relaxed text-zinc-400">
        {FROZEN.doctrine} We are not affiliated with Gearfire or RetailBI. We
        do not ask anyone to switch off RetailBI. Keep the register series if
        it serves the store. Add search intent on the website.
      </p>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="text-xl font-semibold text-white">Managed path vs self-serve</h2>
      <div class="mt-8 grid gap-4 lg:grid-cols-2">
        <article
          class="rounded-2xl border border-emerald-500/35 bg-emerald-500/10 p-6"
        >
          <p
            class="text-[11px] font-semibold uppercase tracking-[0.16em] text-emerald-300"
          >
            Primary
          </p>
          <h3 class="mt-1 text-lg font-semibold text-white">
            FFL Accelerator · $569/mo
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-300">
            Coriolis runs WooCommerce you own, including GunSearchAgent Pro.
            Right when the website itself is the problem — rented, slow, or
            still dark — and you want the storefront plus the sensor.
          </p>
          <a
            href={LINKS.plans}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-5 inline-flex items-center justify-center rounded-xl border border-emerald-500/35 bg-emerald-500/10 px-5 py-3 text-sm font-semibold text-emerald-200 hover:bg-emerald-500/20"
          >
            See the plan on Coriolis →
          </a>
        </article>
        <article class="rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6">
          <p
            class="text-[11px] font-semibold uppercase tracking-[0.16em] text-sky-400"
          >
            Already have a site
          </p>
          <h3 class="mt-1 text-lg font-semibold text-white">
            GunSearchAgent self-serve
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-400">
            Keep the current storefront. Put the free core (or Pro) on it. Same
            sensor family, no managed Woo required. Literacy for AXIS retailers
            lives on GSA.
          </p>
          <a
            href={LINKS.gsaRetailBi}
            target="_blank"
            rel="noopener noreferrer"
            class:list={["mt-5", btnSecondary]}
          >
            GSA: RetailBI and your gun store →
          </a>
        </article>
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-6xl px-4 space-y-4">
      <CommercialLine />
      <p class="text-sm text-zinc-400">
        Definitions:{" "}
        <a
          href={LINKS.betsyVsRetailBi}
          class={linkClass}
          target="_blank"
          rel="noopener noreferrer">Betsy vs RetailBI</a
        >
        {" · "}
        <a
          href={LINKS.retailBiIndex}
          class={linkClass}
          target="_blank"
          rel="noopener noreferrer">Firearm Sales Index</a
        >
        {" · "}
        <a
          href={LINKS.nicsVsSales}
          class={linkClass}
          target="_blank"
          rel="noopener noreferrer">NICS vs sales</a
        >
        {" · "}
        <a
          href={LINKS.fflintelMethodology}
          class={linkClass}
          target="_blank"
          rel="noopener noreferrer">FFLIntel methodology</a
        >
      </p>
    </div>
  </section>

  <FaqBlock items={FAQ_RETAILBI} />
</BaseLayout>
