---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import { CANON_PATHS } from "../lib/site";
import { withBase } from "../lib/base";
---

<BaseLayout
  title="About FFL Accelerator"
  description="FFL Accelerator is Coriolis’s plan for gun store websites. $569 a month. Built in Greenville, SC."
  path="/about/"
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid gap-10 lg:grid-cols-[1.2fr_0.6fr] lg:items-center">
        <div>
          <h1 class="max-w-3xl text-3xl font-semibold tracking-tight text-white sm:text-4xl">
            We build gun store websites. This is the plan.
          </h1>
          <div class="mt-6 max-w-2xl space-y-4 text-sm leading-relaxed text-zinc-300">
            <p>
              FFL Accelerator is a Coriolis program. Coriolis, LLC is in
              Greenville, South Carolina. We have been putting firearms dealers
              on websites they own for years. The founder ran AmmoReady for
              nine years. This site is for shop owners who want that work.
            </p>
            <p>
              The plan is $569 a month. We build WooCommerce on your domain
              and run it with you. Betsy is on the shop. You leave with the
              site.
            </p>
          </div>
          <div class="mt-8">
            <CtaRow />
          </div>
        </div>
        <img
          src={withBase(CANON_PATHS.sales)}
          alt="Add to cart on a gun store website"
          width="1024"
          height="683"
          class="mx-auto w-full rounded-2xl object-cover ring-1 ring-white/10"
        />
      </div>
    </div>
  </section>
</BaseLayout>
