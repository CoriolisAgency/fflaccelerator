---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
---

<BaseLayout
  title="You are on the list | FFL Accelerator"
  description="Notes on store websites. Unsubscribe any time."
  path="/confirmed/"
  emailCapture={false}
  noindex={true}
>
  <article class="mx-auto max-w-xl px-5 py-16 sm:px-8">
    <p class="text-sm font-medium text-muted">FFL Accelerator</p>
    <div id="confirm-ok">
      <h1 class="type-display mt-3 text-5xl">You’re on the list</h1>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        Notes on store websites. Unsubscribe any time.
      </p>
    </div>
    <div id="confirm-bad" hidden>
      <h2 class="type-display mt-3 text-5xl">That link did not work</h2>
      <p class="mt-4 text-lg leading-relaxed text-muted">
        It may have expired. Open the popup again and we’ll send a fresh
        confirmation.
      </p>
    </div>
    <CtaRow />
  </article>
  <script>
    const params = new URLSearchParams(window.location.search);
    const ok = params.get("ok") !== "0";
    const good = document.getElementById("confirm-ok");
    const bad = document.getElementById("confirm-bad");
    if (!ok) {
      if (good) good.hidden = true;
      if (bad) bad.hidden = false;
    }
  </script>
</BaseLayout>
