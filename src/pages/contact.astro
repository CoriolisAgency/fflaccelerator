---
import BaseLayout from "../layouts/BaseLayout.astro";
import LeadForm from "@coriolis/lead-form/LeadForm.astro";
import { SITE } from "../lib/site";
import { PATHS, linkClass } from "../lib/links";
import { withBase } from "../lib/base";
---

<BaseLayout
  title="Contact | FFL Accelerator"
  description="Tell us about the store. Coriolis, LLC. Greenville, SC."
  path="/contact/"
  emailCapture={false}
>
  <section class="py-12 sm:py-16">
    <div class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-2">
      <div class="min-w-0">
        <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold">
          Contact
        </p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
          Tell us what you need
        </h1>
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-zinc-400">
          Tell us about the website you want. We build, host, and support the
          WooCommerce store. There is no contract, and you can cancel at any
          time.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-zinc-400">
          Coriolis, LLC. {SITE.street}, {SITE.origin}.
          <a class={linkClass} href={SITE.phoneHref}>{SITE.phone}</a>
        </p>
        <p class="mt-4 text-sm text-zinc-500">
          <a class={linkClass} href={withBase(PATHS.privacy)}>Privacy</a>
        </p>
      </div>
      <LeadForm site="fflaccelerator" defaultPillar="Ecommerce" />
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* Theme the shared form to this site's palette. */
  form.lf-form[data-lf-form] {
    --lf-fg: #a1a1aa;
    --lf-muted: #52525b;
    --lf-border: #3f3f46;
    --lf-card-border: #27272a;
    --lf-surface: rgba(9, 9, 11, 0.5);
    --lf-field: var(--color-ink);
    --lf-input: #f4f4f5;
    --lf-accent: var(--color-gold);
    --lf-accent-ink: var(--color-ink);
    --lf-success: #7dd3fc;
    --lf-error: #fcd34d;
  }
  form.lf-form[data-lf-form] .lf-submit:hover:not(:disabled) {
    background: #fcd34d;
    filter: none;
  }
</style>
