---
import BaseLayout from "../layouts/BaseLayout.astro";
import LeadForm from "@coriolis/lead-form/LeadForm.astro";
import { SITE } from "../lib/site";
import { PATHS, linkClass } from "../lib/links";
import { withBase } from "../lib/base";
---

<BaseLayout
  title="Contact | FFL Accelerator"
  description="Tell us about the store. Coriolis, LLC. Greenville, SC."
  path="/contact/"
  emailCapture={false}
>
  <section
    class="mx-auto grid max-w-7xl gap-12 px-5 py-16 sm:px-8 lg:grid-cols-12 lg:py-24"
  >
    <div class="lg:col-span-5">
      <p class="text-sm font-medium text-muted">Contact</p>
      <h1 class="type-display mt-3 text-5xl text-ink sm:text-6xl">
        Tell us what you need
      </h1>
      <p class="mt-6 max-w-md text-lg leading-relaxed">
        Your note goes to the Coriolis team that builds and runs the stores.
        Rather talk? Call <a class={linkClass} href={SITE.phoneHref}>{SITE.phone}</a>.
      </p>
      <p class="mt-6 text-sm leading-relaxed">
        Coriolis, LLC. {SITE.origin}.
        <br />
        <a class={linkClass} href={SITE.phoneHref}>{SITE.phone}</a>
      </p>
      <p class="mt-4">
        <a class={`text-sm ${linkClass}`} href={withBase(PATHS.privacy)}>Privacy</a>
      </p>
      <img
        src={withBase("photos/muffs.jpg")}
        alt="Hearing protection and safety glasses"
        class="mt-10 hidden h-56 w-full object-cover lg:block"
      />
    </div>
    <div class="relative bg-paper-2 p-6 sm:p-8 lg:col-span-7">
      <LeadForm site="fflaccelerator" defaultPillar="Ecommerce" pillars={["Ecommerce"]} />
    </div>
  </section>
</BaseLayout>
