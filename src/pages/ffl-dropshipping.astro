---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import CommercialLine from "../components/CommercialLine.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { FAQ_DROPSHIP } from "../lib/faq";
import { FROZEN } from "../lib/frozen";
import { LINKS, linkClass } from "../lib/links";
import { withBase } from "../lib/base";
---

<BaseLayout
  title="FFL Dropshipping on WooCommerce You Own | FFL Accelerator"
  description="FFL dropshipping on managed WooCommerce: 21 distributor catalogs, lowest-cost routing, FFL checkout. Starts on Militia ($269). FFL Accelerator ($569) includes catalogs plus GunSearchAgent Pro."
  path="/ffl-dropshipping"
  faq={FAQ_DROPSHIP}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.18em] text-sky-400"
      >
        FFL dropshipping
      </p>
      <h1 class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-white sm:text-4xl">
        Endless aisle. Real FFL workflows. Site you own.
      </h1>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-zinc-300">
        Licensed dealers can sell firearms and accessories online without
        stocking every SKU. Coriolis wires FFL Cockpit catalogs, pricing
        controls, and lowest-cost routing into WooCommerce you own — not a
        rented black box. Dropshipping starts on Militia ($269). FFL Accelerator
        ($569) includes that stack plus GunSearchAgent Pro.{" "}
        {FROZEN.commercialLine}
      </p>
      <div class="mt-8">
        <CtaRow />
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4">
      <h2 class="text-xl font-semibold text-white">How it works</h2>
      <ol class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          [
            {
              n: "1",
              t: "Connect distributors",
              d: "We guide account setup. Militia+ includes 21 catalogs with frequent updates.",
            },
            {
              n: "2",
              t: "Catalog streams in",
              d: "Live inventory and pricing into WooCommerce with your MAP and margin rules.",
            },
            {
              n: "3",
              t: "Customer checks out",
              d: "FFL transfer flow routes the firearm to a local FFL of their choice.",
            },
            {
              n: "4",
              t: "Order routes out",
              d: "Automated lowest-cost fulfillment. You keep the customer relationship.",
            },
          ].map((s) => (
            <li class="rounded-2xl border border-zinc-800 bg-zinc-950/50 p-5">
              <span class="text-xs font-bold text-sky-400">{s.n}</span>
              <h3 class="mt-1 text-sm font-semibold text-white">{s.t}</h3>
              <p class="mt-2 text-sm text-zinc-400">{s.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4">
      <h2 class="text-xl font-semibold text-white">
        Included on Militia and above
      </h2>
      <p class="mt-2 max-w-2xl text-sm text-zinc-400">
        AmmoSeek product feed, GunBroker listing automation, and email support.
        Scale support and POS on Gun Runner and Warlord. Accelerator adds Betsy
        so the endless aisle is not a dark catalog.
      </p>
      <div class="mt-8 rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6 text-sm text-zinc-400">
        <p>
          Bound-book and serialized workflows are designed to coexist with{" "}
          <a
            href={LINKS.fastBound}
            class={linkClass}
            target="_blank"
            rel="noopener noreferrer">FastBound</a
          >. Coriolis provides compliance-aware ecommerce — not legal advice and
          not 4473 automation.
        </p>
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-7xl px-4 space-y-4">
      <CommercialLine />
      <CtaRow />
      <p class="text-sm text-zinc-400">
        <a href={withBase("ffl-ecommerce")} class={linkClass}>FFL ecommerce pillar →</a>
        {" · "}
        <a href={withBase("plan")} class={linkClass}>Compare plans →</a>
      </p>
    </div>
  </section>

  <FaqBlock items={FAQ_DROPSHIP} />
</BaseLayout>
