---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import CommercialLine from "../components/CommercialLine.astro";
import FaqBlock from "../components/FaqBlock.astro";
import PlanCard from "../components/PlanCard.astro";
import { FAQ_PLAN } from "../lib/faq";
import { FROZEN } from "../lib/frozen";
import { PLANS, SETUP } from "../lib/plans";
import { LINKS, linkClass } from "../lib/links";
---

<BaseLayout
  title="FFL Accelerator Plan — $569/mo vs Minute Man, Militia, Gun Runner, Warlord"
  description="FFL Accelerator is Coriolis’s $569/mo managed WooCommerce plan. It includes everything through Warlord plus GunSearchAgent Pro. Setup $500 Basic / $2,500 Retail. Buy on Coriolis."
  path="/plan"
  faq={FAQ_PLAN}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto max-w-6xl px-4">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.18em] text-sky-400"
      >
        Coriolis plan ladder
      </p>
      <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl">
        FFL Accelerator is the $569 plan
      </h1>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-zinc-300">
        {FROZEN.fflAccelerator} Lower Coriolis tiers still exist: Minute Man
        $169, Militia $269, Gun Runner $369, Warlord $469. Older $269 copy on
        this domain was Militia, not Accelerator.
      </p>
      <p class="mt-3 max-w-2xl text-sm text-zinc-400">
        This page explains the ladder. It is not a second checkout. Subscribe at{" "}
        <a
          href={LINKS.plans}
          class={linkClass}
          target="_blank"
          rel="noopener noreferrer">coriolisagency.com/plans</a
        >.
      </p>
      <div class="mt-8">
        <CtaRow showGsa={false} />
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-6xl px-4">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
        {PLANS.map((plan) => <PlanCard plan={plan} />)}
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="text-2xl font-semibold text-white">Setup (one-time)</h2>
      <p class="mt-2 max-w-2xl text-sm text-zinc-400">
        Honest numbers from Coriolis: <strong class="text-zinc-200"
          >$500 Basic</strong
        >{" "}
        or{" "}
        <strong class="text-zinc-200">$2,500 Retail</strong>. Buy the setup on
        Coriolis. Ask about migration credits when you leave another platform.
      </p>
      <div class="mt-8 grid gap-4 lg:grid-cols-2">
        {
          SETUP.map((pkg) => (
            <article class="rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6">
              <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-sky-400">
                {pkg.hook}
              </p>
              <h3 class="mt-1 text-xl font-semibold text-white">{pkg.name}</h3>
              <p class="mt-3 text-3xl font-semibold text-white">
                ${pkg.price.toLocaleString()}
                <span class="text-sm font-normal text-zinc-500"> one-time</span>
              </p>
              <ul class="mt-4 space-y-2 text-sm text-zinc-400">
                {pkg.features.map((f) => (
                  <li class="flex gap-2">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-sky-500" />
                    <span>{f}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-6xl px-4 space-y-4">
      <CommercialLine />
      <div>
        <CtaRow showGsa={false} />
      </div>
    </div>
  </section>

  <FaqBlock items={FAQ_PLAN} />
</BaseLayout>
