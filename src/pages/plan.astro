---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlanSummary from "../components/PlanSummary.astro";
import FeatureLines from "../components/FeatureLines.astro";
import FaqBlock from "../components/FaqBlock.astro";
import MsaNote from "../components/MsaNote.astro";
import CtaRow from "../components/CtaRow.astro";
import { FAQ_PLAN } from "../lib/faq";
import { PATHS } from "../lib/links";
import { GROUPS, SETUP, SWITCH_STEPS } from "../lib/plans";
import { withBase } from "../lib/base";

const planTitle = "What is included | FFL Accelerator";
const planDescription =
  "Hosting, design, catalogs, checkout, point of sale, email, monitoring, and analytics.";

const toc = [
  ...GROUPS.map((group) => ({ href: `#${group.id}`, label: group.title })),
  { href: "#switch-existing-site", label: "Switch" },
  { href: "#setup", label: "Setup" },
];
---

<BaseLayout title={planTitle} description={planDescription} path="/plan/" faq={FAQ_PLAN}>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <PlanSummary />
      <nav class="mt-10 flex flex-wrap gap-2" aria-label="On this page">
        {
          toc.map((item) => (
            <a
              href={item.href}
              class="rounded-sm border border-zinc-700 px-2.5 py-1.5 text-xs text-zinc-300 hover:border-gold/50 hover:text-gold"
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  {
    GROUPS.map((group) => (
      <section class="border-b border-zinc-800/80 py-12" id={group.id}>
        <div class="mx-auto max-w-7xl px-4 sm:px-6">
          <h2 class="text-xl font-semibold text-white">{group.title}</h2>
          {group.id === "store-hosting" && (
            <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400">
              Your domain, your pages, your hosting.
            </p>
          )}
          <FeatureLines features={group.features} />
          <a
            href={withBase(PATHS.contact)}
            class="mt-6 inline-flex items-center justify-center rounded-sm border border-zinc-500 px-3 py-1.5 text-xs font-semibold text-zinc-100 hover:bg-zinc-800"
          >
            Talk to us
          </a>
        </div>
      </section>
    ))
  }

  <section class="border-b border-zinc-800/80 py-12" id="switch-existing-site">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">Switch an existing site</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400">
        Keep the register you already run. We replace the website. Coriolis is
        not affiliated with Gearfire or RetailBI.
      </p>
      <ol class="mt-4 max-w-3xl list-decimal space-y-2 pl-5 text-sm leading-relaxed text-zinc-300">
        {SWITCH_STEPS.map((step) => <li>{step}</li>)}
      </ol>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12" id="setup">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">Setup</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {
          SETUP.map((s) => (
            <article class="flex flex-col rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6">
              <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-zinc-500">
                {s.hook}
              </p>
              <h3 class="mt-2 text-lg font-semibold text-white">{s.name}</h3>
              <p class="mt-1 text-2xl font-semibold text-gold">
                ${s.price.toLocaleString()}
                <span class="text-sm font-medium text-zinc-500"> one-time</span>
              </p>
              <ul class="mt-4 flex-1 space-y-1.5 text-sm text-zinc-400">
                {s.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <div class="mt-8">
        <CtaRow />
      </div>
    </div>
  </section>

  <FaqBlock items={FAQ_PLAN} title="FAQ" />
  <MsaNote />
</BaseLayout>
