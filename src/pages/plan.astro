---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import CommercialLine from "../components/CommercialLine.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { FAQ_PLAN } from "../lib/faq";
import { FROZEN } from "../lib/frozen";
import { SETUP } from "../lib/plans";
import { LINKS, linkClass } from "../lib/links";
---

<BaseLayout
  title="FFL Accelerator Plan — $569/mo, Betsy AI included"
  description="FFL Accelerator is Coriolis’s $569/mo managed WooCommerce plan. GunSearchAgent Pro is included. Setup $500 or $2,500. Buy on Coriolis."
  path="/plan/"
  faq={FAQ_PLAN}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold">
        The product
      </p>
      <h1 class="mt-3 max-w-4xl text-3xl font-semibold tracking-tight text-white sm:text-5xl">
        $569 a month. The site is yours. Betsy AI is on it.
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-zinc-300">
        {FROZEN.fflAccelerator} Checkout is on Coriolis. This page is not a
        second cart.
      </p>
      <div class="mt-8">
        <CtaRow />
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">What’s in Accelerator</h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 xl:grid-cols-3 text-sm text-zinc-300">
        <li class="rounded-xl border border-zinc-800 bg-zinc-950/50 p-4">Managed WooCommerce you own</li>
        <li class="rounded-xl border border-zinc-800 bg-zinc-950/50 p-4">FFL checkout and catalogs</li>
        <li class="rounded-xl border border-zinc-800 bg-zinc-950/50 p-4">GunSearchAgent Pro (Betsy)</li>
        <li class="rounded-xl border border-zinc-800 bg-zinc-950/50 p-4">Dropshipping path when you need it</li>
        <li class="rounded-xl border border-zinc-800 bg-zinc-950/50 p-4">POS integrations when you need them</li>
        <li class="rounded-xl border border-zinc-800 bg-zinc-950/50 p-4">Cloudflare, speed, on-site SEO, email</li>
      </ul>
      <p class="mt-6"><CommercialLine /></p>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">One-time setup</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {
          SETUP.map((s) => (
            <article class="rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6">
              <h3 class="text-lg font-semibold text-white">
                {s.name} · ${s.price.toLocaleString()}
              </h3>
              <p class="mt-1 text-sm text-zinc-400">{s.hook}</p>
              <ul class="mt-4 space-y-1.5 text-sm text-zinc-400">
                {s.features.slice(0, 6).map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-lg font-semibold text-zinc-200">Lower Coriolis tiers</h2>
      <p class="mt-2 max-w-3xl text-sm text-zinc-500">
        Minute Man $169, Militia $269, Gun Runner $369, Warlord $469 still
        exist on{" "}
        <a href={LINKS.plans} class={linkClass} target="_blank" rel="noopener noreferrer"
          >coriolisagency.com/plans</a
        >. Older $269 copy on this domain was Militia, not Accelerator. This
        site sells the $569 plan.
      </p>
    </div>
  </section>

  <FaqBlock items={FAQ_PLAN} />
</BaseLayout>
