---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import FeatureLines from "../components/FeatureLines.astro";
import FaqBlock from "../components/FaqBlock.astro";
import Talk from "../components/Talk.astro";
import CtaRow from "../components/CtaRow.astro";
import { FAQ_PLAN } from "../lib/faq";
import { GROUPS, SETUP, SWITCH_STEPS } from "../lib/plans";

const planTitle = "What is included | FFL Accelerator";
const planDescription =
  "Hosting, design, catalogs, checkout, point of sale, email, monitoring, and analytics.";

const toc = [
  ...GROUPS.map((group) => ({ href: `#${group.id}`, label: group.title })),
  { href: "#switch-existing-site", label: "Switch" },
  { href: "#setup", label: "Setup" },
];
---

<BaseLayout title={planTitle} description={planDescription} path="/plan/" faq={FAQ_PLAN}>
  <Hero
    image="photos/ranch.jpg"
    alt="Two people sighting a rifle from a field"
    focus="center 68%"
    primaryLabel="Schedule Demo"
  />
  <nav
    class="sticky top-16 z-30 border-b border-line bg-paper"
    aria-label="On this page"
  >
    <div class="jump mx-auto max-w-7xl px-5 py-3 sm:px-8">
      {
        toc.map((item) => (
          <a href={item.href} class="shrink-0 py-2 text-sm text-muted hover:text-ink">
            {item.label}
          </a>
        ))
      }
    </div>
  </nav>

  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    {
      GROUPS.map((group) => (
        <section
          id={group.id}
          class="border-b border-line py-12 lg:grid lg:grid-cols-12 lg:gap-12 lg:py-16"
        >
          <h2 class="type-display text-3xl text-ink sm:text-4xl lg:col-span-5">
            {group.title}
          </h2>
          <div class="mt-5 lg:col-span-7 lg:mt-1">
            {group.lede ? <p class="mb-4 max-w-xl">{group.lede}</p> : null}
            <FeatureLines features={group.features} />
            <Talk />
          </div>
        </section>
      ))
    }

    <section
      id="switch-existing-site"
      class="border-b border-line py-12 lg:grid lg:grid-cols-12 lg:gap-12 lg:py-16"
    >
      <h2 class="type-display text-3xl text-ink sm:text-4xl lg:col-span-5">
        Switch an existing site
      </h2>
      <div class="mt-5 lg:col-span-7 lg:mt-1">
        <p class="max-w-xl">
          Keep the register you already run. We replace the website. Coriolis is
          not affiliated with Gearfire or RetailBI.
        </p>
        <div class="mt-4">
          <FeatureLines features={SWITCH_STEPS} />
        </div>
        <Talk />
      </div>
    </section>

    <section class="py-12 lg:py-16" id="setup">
      <h2 class="type-display text-3xl text-ink sm:text-4xl">Setup</h2>
      <div class="mt-10 grid gap-12 lg:grid-cols-2 lg:gap-16">
        {
          SETUP.map((s, i) => (
            <div
              class:list={[
                i === 1 &&
                  "border-t border-line pt-10 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-16",
              ]}
            >
              <p class="text-sm font-medium text-muted">{s.hook}</p>
              <h3 class="type-display mt-2 text-3xl">{s.name}</h3>
              <p class="type-display mt-3 text-2xl">
                ${s.price.toLocaleString()} one-time
              </p>
              <div class="mt-5">
                <FeatureLines features={s.features} />
              </div>
            </div>
          ))
        }
      </div>
      <CtaRow />
    </section>
  </div>

  <FaqBlock items={FAQ_PLAN} title="FAQ" />
</BaseLayout>
