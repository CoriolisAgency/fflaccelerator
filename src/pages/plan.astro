---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { FAQ_PLAN } from "../lib/faq";
---

<BaseLayout
  title="FFL Accelerator plan — $569 a month"
  description="What is in FFL Accelerator: a WooCommerce store you own, FFL checkout, twenty-one catalogs, Betsy on the site. Setup $500 or $2,500."
  path="/plan/"
  faq={FAQ_PLAN}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h1 class="max-w-4xl text-3xl font-semibold tracking-tight text-white sm:text-5xl">
        $569 a month. The site is yours.
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-zinc-300">
        FFL Accelerator is the plan we put a working gun store on. We build
        WooCommerce on your domain, wire checkout and catalogs, and stay on the
        shop. Betsy is on that site so you can see what people asked for.
      </p>
      <div class="mt-8">
        <CtaRow />
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">Price</h2>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-300">
        FFL Accelerator is $569 a month. Standing the store up is $500 for a
        clean branded shop, or $2,500 if you want the full custom site and
        email. There is no year-long lock. If you leave, the website goes with
        you.
      </p>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">What’s in it</h2>
      <ul class="mt-6 grid gap-3 sm:grid-cols-2 text-sm text-zinc-300">
        <li class="rounded-xl border border-zinc-800 bg-zinc-950/50 p-4">
          A WooCommerce store on your domain
        </li>
        <li class="rounded-xl border border-zinc-800 bg-zinc-950/50 p-4">
          FFL checkout for serialized firearms
        </li>
        <li class="rounded-xl border border-zinc-800 bg-zinc-950/50 p-4">
          Twenty-one distributor catalogs when you want the aisle
        </li>
        <li class="rounded-xl border border-zinc-800 bg-zinc-950/50 p-4">
          The register you already run, connected when you want the floor and
          the site together
        </li>
        <li class="rounded-xl border border-zinc-800 bg-zinc-950/50 p-4">
          Betsy on the shop
        </li>
        <li class="rounded-xl border border-zinc-800 bg-zinc-950/50 p-4">
          Speed, Cloudflare, search work, and email after a missed sale
        </li>
        <li class="rounded-xl border border-zinc-800 bg-zinc-950/50 p-4">
          The site runs on WP Engine with no storage cap.
        </li>
        <li class="rounded-xl border border-zinc-800 bg-zinc-950/50 p-4">
          The host commits to 99.95% uptime.
        </li>
        <li class="rounded-xl border border-zinc-800 bg-zinc-950/50 p-4">
          You get us Monday through Friday.
        </li>
        <li class="rounded-xl border border-zinc-800 bg-zinc-950/50 p-4">
          We run the emails a shop actually uses: welcome, back in stock,
          abandoned cart, thank you.
        </li>
      </ul>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">Setup</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        <article class="rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6">
          <h3 class="text-lg font-semibold text-white">$500 · Open the store</h3>
          <p class="mt-3 text-sm leading-relaxed text-zinc-400">
            A branded shop on your domain. Theme, homepage, search, tax and
            shipping, payments, checkout, catalogs, and Betsy’s free layer.
          </p>
        </article>
        <article class="rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6">
          <h3 class="text-lg font-semibold text-white">
            $2,500 · Build the store you will keep
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-zinc-400">
            The full custom site: up to ten pages, unlimited revisions, and
            email that actually sends.
          </p>
        </article>
      </div>
      <p class="mt-6 max-w-3xl text-sm leading-relaxed text-zinc-400">
        You pay setup once. The $569 starts when the shop is yours to run.
      </p>
      <div class="mt-8">
        <CtaRow />
      </div>
    </div>
  </section>

  <FaqBlock items={FAQ_PLAN} />
</BaseLayout>
