---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import CommercialLine from "../components/CommercialLine.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { FAQ_SWITCH } from "../lib/faq";
import { FROZEN } from "../lib/frozen";
import { LINKS, linkClass } from "../lib/links";
import { withBase } from "../lib/base";
---

<BaseLayout
  title="Gearfire Website Alternative for Retailers — Switch to Woo + Betsy"
  description="Leave a Gearfire or AmmoReady website for WooCommerce you own. FFL Accelerator ($569/mo) includes GunSearchAgent Pro. This is not a request to leave RetailBI."
  path="/switch"
  faq={FAQ_SWITCH}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4">
      <p
        class="text-[11px] font-semibold uppercase tracking-[0.18em] text-sky-400"
      >
        Gearfire website alternative · retailer
      </p>
      <h1 class="mt-3 max-w-3xl text-3xl font-semibold tracking-tight text-white sm:text-4xl">
        Leave Gearfire or AmmoReady. Own Woo + Betsy.
      </h1>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-zinc-300">
        FFL Accelerator is the retailer path off a rented FFL website: open
        WooCommerce you own, FFL checkout, dropshipping when you need it, and
        GunSearchAgent Pro on the domain. {FROZEN.commercialLine} We are not
        asking you to switch off RetailBI.
      </p>
      <div class="mt-8">
        <CtaRow />
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4">
      <div class="grid gap-4 lg:grid-cols-2">
        <article class="rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6">
          <h2 class="text-lg font-semibold text-white">
            Gearfire website alternative
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-zinc-400">
            Keep the counter tools that still work. Move the public storefront
            to WooCommerce Coriolis actually hosts. Speed, merchandising, SEO,
            and a demand sensor you control — without another all-in-one cage
            for the site itself.
          </p>
        </article>
        <article class="rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6">
          <h2 class="text-lg font-semibold text-white">
            AmmoReady alternative
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-zinc-400">
            Keep the dropshipping model you know. Militia and above wire FFL
            Cockpit catalogs into a store you own. Accelerator adds Betsy so
            the new site is not dark on day one. Coriolis was founded by the
            person who ran AmmoReady for nine years.
          </p>
        </article>
      </div>
      <ul class="mt-8 space-y-2 text-sm text-zinc-400">
        <li>✓ Site ownership + backup on cancel</li>
        <li>✓ Domain, catalog, and customer relationship come with you</li>
        <li>✓ Dropshipping, POS path, and GunSearchAgent Pro on Accelerator</li>
        <li>✓ RetailBI can stay if you still feed it via AXIS or the network</li>
      </ul>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 space-y-4">
      <h2 class="text-xl font-semibold text-white">
        Website vs sell-through — do not mash the two
      </h2>
      <p class="max-w-2xl text-sm leading-relaxed text-zinc-400">
        {FROZEN.retailBi}
      </p>
      <p class="max-w-2xl text-sm leading-relaxed text-zinc-400">
        {FROZEN.doctrine} Leaving a Gearfire <em class="not-italic text-zinc-300"
          >website</em
        >{" "}
        is a storefront decision. It is not a vote against the register series.
        If you already report units, keep reporting them. Put Betsy on the site
        you own.
      </p>
      <p class="text-sm">
        <a href={withBase("retailbi-and-axis")} class={linkClass}
          >Already on AXIS? Read the firebase page →</a
        >
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-7xl px-4 space-y-4">
      <CommercialLine />
      <CtaRow />
      <p class="text-xs text-zinc-500">
        Agency HQ switch page:{" "}
        <a
          href={LINKS.coriolisSwitch}
          class={linkClass}
          target="_blank"
          rel="noopener noreferrer">coriolisagency.com/ammoready-alternative</a
        >.
      </p>
    </div>
  </section>

  <FaqBlock items={FAQ_SWITCH} />
</BaseLayout>
