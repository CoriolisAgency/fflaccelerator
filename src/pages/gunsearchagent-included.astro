---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { FAQ_GSA } from "../lib/faq";
import { CANON_PATHS } from "../lib/site";
import { withBase } from "../lib/base";
---

<BaseLayout
  title="Betsy is on the shop — included with FFL Accelerator"
  description="FFL Accelerator includes Betsy on your website. She writes down what customers searched for, including the guns you did not have."
  path="/gunsearchagent-included/"
  faq={FAQ_GSA}
>
  <section class="border-b border-zinc-800/80 py-12 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h1 class="max-w-4xl text-3xl font-semibold tracking-tight text-white sm:text-5xl">
        Betsy is on the shop
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-zinc-300">
        A store can be open and still be blind. Google Analytics will tell you
        someone bounced. It will not tell you they typed a model you do not
        carry. Betsy sits on your site and writes those searches down,
        including the empty ones. That is included in FFL Accelerator.
      </p>
      <div class="mt-8">
        <CtaRow />
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <img
        src={withBase(CANON_PATHS.sales)}
        alt="Add to cart on a gun store website"
        width="1024"
        height="683"
        class="w-full rounded-2xl object-cover ring-1 ring-zinc-700/80"
      />
    </div>
  </section>

  <section class="border-b border-zinc-800/80 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">What she is for</h2>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-300">
        She is there so you can see demand on your own website. Stock, page, or
        dropship from what they actually asked for. She is not a register and
        she is not a sales report.
      </p>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-400">
        If you already have a site and you are not ready for us to run it,
        GunSearchAgent’s free layer can go on that shop. This page is still
        selling FFL Accelerator.
      </p>
      <div class="mt-8">
        <CtaRow />
      </div>
    </div>
  </section>

  <FaqBlock items={FAQ_GSA} />
</BaseLayout>
