---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LeadForm from "@coriolis/lead-form/LeadForm.astro";
import FeatureLines from "../../components/FeatureLines.astro";
import { GROUPS, PLAN, SWITCH_STEPS } from "../../lib/plans";
import { SITE } from "../../lib/site";
import { linkClass } from "../../lib/links";

const title = "A store website you own | FFL Accelerator";
const description = SITE.description;
---

<BaseLayout
  title={title}
  description={description}
  path="/lp/"
  noindex={true}
  adLanding={true}
>
  <section
    class="mx-auto grid max-w-7xl gap-12 px-5 py-16 sm:px-8 lg:grid-cols-12 lg:py-24"
  >
    <div class="lg:col-span-5">
      <p class="text-sm font-medium text-muted">{PLAN.eyebrow}</p>
      <h1 class="lp-hero__title mt-3 text-ink">FFL Ecommerce <span class="lp-hero__accent">as a Service</span></h1>
      <p class="lp-hero__sub mt-4 text-ink">Your online store, run for you.</p>
      <p class="mt-4 text-sm font-medium tracking-wide text-muted">{PLAN.badge}</p>
      <p class="type-display mt-6 text-3xl">{PLAN.priceLabel}</p>
      <p class="mt-6 max-w-md text-lg leading-relaxed">{PLAN.lpLead}</p>
      <p class="mt-4 max-w-md text-base leading-relaxed text-muted">{PLAN.lpBody}</p>
      <p class="mt-4 max-w-md text-sm leading-relaxed text-muted">The site is yours.</p>
      <p class="mt-4 max-w-md text-sm leading-relaxed text-muted">
        Setup is $500 one-time for a branded online storefront, or $2,500
        one-time for a full custom website.
      </p>
      <p class="mt-6 text-sm leading-relaxed">
        Coriolis, LLC. {SITE.origin}.
        <br />
        <a class={linkClass} href={SITE.phoneHref}>{SITE.phone}</a>
      </p>
    </div>
    <div class="relative bg-paper-2 p-6 sm:p-8 lg:col-span-7">
      <LeadForm site="fflaccelerator" defaultPillar="Ecommerce" pillars={["Ecommerce"]} />
    </div>
  </section>

  <section class="border-t border-line bg-paper-2 py-16">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <h2 class="type-display text-4xl text-ink">What is included</h2>
      <div class="mt-10 grid gap-8 md:grid-cols-2 xl:grid-cols-3">
        {
          GROUPS.map((group) => (
            <article class="border-t border-line pt-5">
              <h3 class="type-display text-2xl">{group.title}</h3>
              <div class="mt-3">
                <FeatureLines features={group.features} />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-t border-line py-16">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <h2 class="type-display text-4xl text-ink">An FFL website, built and run for you</h2>
      <div class="mt-10 grid gap-10 md:grid-cols-2">
        <article id="software" class="border-t border-line pt-5">
          <h3 class="type-display text-2xl">Store software for FFL dealers</h3>
          <p class="mt-3 leading-relaxed">
            One managed service covers your website, distributor catalogs, orders,
            FFL Checkout, and email. It is ecommerce software for FFL dealers, not
            record-keeping software.
          </p>
        </article>
        <article id="switch" class="border-t border-line pt-5">
          <h3 class="type-display text-2xl">Switch your FFL website</h3>
          <ol class="mt-3 list-decimal space-y-2 pl-5 leading-relaxed">
            {SWITCH_STEPS.map((step) => <li>{step}</li>)}
          </ol>
        </article>
        <article id="catalog" class="border-t border-line pt-5">
          <h3 class="type-display text-2xl">FFL ecommerce with distributor catalogs</h3>
          <p class="mt-3 leading-relaxed">
            Your online store loads 21 distributor catalogs, updates inventory every
            20 minutes, and handles automated dropshipping.
          </p>
        </article>
        <article id="pos" class="border-t border-line pt-5">
          <h3 class="type-display text-2xl">Keep the register you run</h3>
          <p class="mt-3 leading-relaxed">
            The site and the counter share inventory by API, with two-way sync. Works with AIM Point of
            Sale, GunBiz POS, Trident 1 POS, and other registers.
          </p>
        </article>
        <article id="email" class="border-t border-line pt-5">
          <h3 class="type-display text-2xl">Email marketing for FFL stores</h3>
          <p class="mt-3 leading-relaxed">
            Automated Welcome, Back In Stock, Browse Abandonment, Thank You for
            Purchase, and Abandoned Cart emails, plus on-site email capture.
          </p>
        </article>
        <article id="own" class="border-t border-line pt-5">
          <h3 class="type-display text-2xl">A website for FFL dealers that you own</h3>
          <p class="mt-3 leading-relaxed">
            Custom WooCommerce design on your domain. You keep the site. Not a DIY
            builder: we build it and run it.
          </p>
        </article>
        <article id="uptime" class="border-t border-line pt-5">
          <h3 class="type-display text-2xl">Hosting and maintenance included</h3>
          <p class="mt-3 leading-relaxed">
            Unlimited hosting, website maintenance with a webmaster included, VIP
            support for WordPress and WooCommerce, and 24x7 uptime monitoring. Backed by
            WP Engine's 99.95% uptime SLA.
          </p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /*
   * FFLA-LP-H1: /lp/ H1 and subline match the homepage hero and the
   * "FFL Ecommerce as a Service" ads (HomeHero.astro type treatment:
   * Barlow Condensed, uppercase, #f49e10 bar under "as a Service").
   * HomeHero's rules are scoped to the navy homepage hero, so the type
   * rules are mirrored here for the paper /lp/ column; the homepage is
   * unchanged. The H1 wraps inside its own column at every width.
   */
  .lp-hero__title {
    max-width: 100%;
    font-family: "Barlow Condensed", "Arial Narrow", var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 12vw, 4rem);
    line-height: 1;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    overflow-wrap: break-word;
    text-wrap: balance;
  }

  .lp-hero__accent {
    display: block;
    width: fit-content;
    max-width: 100%;
    margin-top: 0.06em;
    padding-bottom: 0.2em;
    background: linear-gradient(#f49e10, #f49e10) left bottom / 100% 0.085em
      no-repeat;
  }

  .lp-hero__sub {
    max-width: 100%;
    font-family: "Barlow Condensed", "Arial Narrow", var(--font-sans);
    font-weight: 500;
    font-size: clamp(1.3rem, 5.4vw, 1.75rem);
    line-height: 1.2;
    overflow-wrap: break-word;
  }

  @media (width >= 1024px) {
    .lp-hero__title {
      font-size: clamp(2.75rem, 4.4vw, 4rem);
    }

    .lp-hero__sub {
      font-size: clamp(1.4rem, 1.9vw, 1.75rem);
    }
  }
</style>
