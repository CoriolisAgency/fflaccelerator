---
import BaseLayout from "../../layouts/BaseLayout.astro";
import LeadForm from "@coriolis/lead-form/LeadForm.astro";
import FeatureLines from "../../components/FeatureLines.astro";
import { GROUPS, PLAN } from "../../lib/plans";
import { SITE } from "../../lib/site";
import { linkClass } from "../../lib/links";
import { withBase } from "../../lib/base";

const title = "A store website you own | FFL Accelerator";
const description = SITE.description;
---

<BaseLayout
  title={title}
  description={description}
  path="/lp/"
  emailCapture={false}
  noindex={true}
  adLanding={true}
>
  <section class="py-12 sm:py-16">
    <div
      class="mx-auto grid w-full max-w-7xl grid-cols-1 gap-10 px-4 sm:px-6 lg:grid-cols-2"
    >
      <div class="min-w-0">
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
        >
          {PLAN.eyebrow}
        </p>
        <h1
          class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-4xl"
        >
          {PLAN.name}
        </h1>
        <p class="mt-4">
          <span
            class="inline-flex rounded-full border border-gold/50 bg-gold/10 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-[0.14em] text-gold"
          >
            {PLAN.badge}
          </span>
        </p>
        <p class="mt-4 text-3xl font-semibold tracking-tight text-white">
          {PLAN.priceLabel}
        </p>
        <p class="mt-4 max-w-xl text-base leading-relaxed text-zinc-300">
          {PLAN.description}
        </p>
        <p class="mt-3 max-w-xl text-sm leading-relaxed text-zinc-400">
          The site is yours.
        </p>
        <p class="mt-4 max-w-xl text-sm leading-relaxed text-zinc-400">
          Setup is $500 one-time for a branded online storefront, or $2,500
          one-time for a full custom website.
        </p>
        <p class="mt-6 text-sm leading-relaxed text-zinc-400">
          Coriolis, LLC. {SITE.street}, {SITE.origin}.
          <a class={linkClass} href={SITE.phoneHref}>{SITE.phone}</a>
        </p>
      </div>
      <LeadForm site="fflaccelerator" defaultPillar="Ecommerce" />
    </div>
  </section>

  <section class="border-t border-zinc-800/80 bg-zinc-950/40 py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <h2 class="text-xl font-semibold text-white">What is included</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {
          GROUPS.map((group) => (
            <article class="rounded-2xl border border-zinc-800 bg-zinc-950/50 p-5">
              <h3 class="text-base font-semibold text-white">{group.title}</h3>
              <FeatureLines features={group.features} dense />
            </article>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  form.lf-form[data-lf-form] {
    --lf-fg: #a1a1aa;
    --lf-muted: #52525b;
    --lf-border: #3f3f46;
    --lf-card-border: #27272a;
    --lf-surface: rgba(9, 9, 11, 0.5);
    --lf-field: var(--color-ink);
    --lf-input: #f4f4f5;
    --lf-accent: var(--color-gold);
    --lf-accent-ink: var(--color-ink);
    --lf-success: #7dd3fc;
    --lf-error: #fcd34d;
  }
  form.lf-form[data-lf-form] .lf-submit:hover:not(:disabled) {
    background: #fcd34d;
    filter: none;
  }
</style>
