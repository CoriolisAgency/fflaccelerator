---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
---

<BaseLayout
  title="Page not found — FFL Accelerator"
  description="The link may be old. The plan is still FFL Accelerator: a gun store website you own, $569 a month."
  path="/404"
>
  <section class="mx-auto max-w-5xl px-4 py-16">
    <h1 class="text-3xl font-semibold text-white">That page is not here</h1>
    <p class="mt-4 max-w-xl text-sm text-zinc-400">
      The link may be old. The plan is still FFL Accelerator: a gun store
      website you own, $569 a month.
    </p>
    <div class="mt-8">
      <CtaRow />
    </div>
  </section>
</BaseLayout>
