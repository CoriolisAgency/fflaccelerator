---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { FAQ_HOME } from "../lib/faq";
import { CANON_PATHS } from "../lib/site";
import { withBase } from "../lib/base";
---

<BaseLayout
  title="FFL Accelerator — a gun store website you own | $569 a month"
  description="Coriolis builds and runs WooCommerce for gun stores. FFL checkout, distributor catalogs, and Betsy on your site. $569 a month. You leave with the website."
  path="/"
  ogImagePath={CANON_PATHS.gaHero}
  faq={FAQ_HOME}
>
  <section class="border-b border-zinc-800/80">
    <div class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-12 sm:px-6 lg:grid-cols-2 lg:py-16">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold">
          FFL Accelerator
        </p>
        <h1 class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-5xl leading-[1.12]">
          A gun store website you own
        </h1>
        <p class="mt-4 text-base leading-relaxed text-zinc-300 sm:text-lg">
          Most shops rent a catalog and call it a website. Coriolis builds
          WooCommerce on your domain and stays on it with you. You sell what is
          in the safe. You dropship from twenty-one distributors. Or you do
          both. That plan is FFL Accelerator.
        </p>
        <div class="mt-8">
          <CtaRow />
        </div>
      </div>
      <div class="relative">
        <img
          src={withBase(CANON_PATHS.storefront)}
          alt="A gun store website you own"
          width="1024"
          height="683"
          class="w-full rounded-2xl object-cover ring-1 ring-white/10"
        />
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 bg-zinc-950/40">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
      <h2 class="text-xl font-semibold text-white">Price</h2>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-300">
        FFL Accelerator is $569 a month. Standing the store up is $500 for a
        clean branded shop, or $2,500 if you want the full custom site and
        email. There is no year-long lock. If you leave, the website goes with
        you.
      </p>
    </div>
  </section>

  <section class="border-b border-zinc-800/80">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
      <h2 class="text-xl font-semibold text-white">What you get</h2>
      <div class="mt-6 space-y-4 max-w-3xl text-sm leading-relaxed text-zinc-300">
        <p>
          A store on your name that can take a real firearms order. FFL
          Checkout routes a serialized gun to a receiving dealer. FFL Cockpit
          keeps the distributor catalogs priced and in stock. If you already
          run a register, we connect it so the counter and the site stay in
          step.
        </p>
        <p>
          Betsy lives on that site. She writes down what people searched for,
          including the guns you did not have.
        </p>
        <p>
          We keep the shop fast and findable: speed, the cart, Cloudflare, and
          the on-page work a store needs if it is going to rank for what you
          sell.
        </p>
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 bg-zinc-950/40">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
      <h2 class="text-xl font-semibold text-white">
        If you are on AmmoReady or Gearfire
      </h2>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-300">
        Those platforms rent you a catalog. The inventory changes. The page
        does not. We build the new store on your domain first. You do not give
        notice until it works. Then you leave with the site.
      </p>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-400">
        Coriolis is not affiliated with Gearfire or RetailBI. Keep the register
        you already run.
      </p>
      <div class="mt-8">
        <CtaRow />
      </div>
    </div>
  </section>

  <FaqBlock items={FAQ_HOME} />
</BaseLayout>
