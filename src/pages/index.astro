---
import BaseLayout from "../layouts/BaseLayout.astro";
import PlanSummary from "../components/PlanSummary.astro";
import FeatureLines from "../components/FeatureLines.astro";
import FaqBlock from "../components/FaqBlock.astro";
import MsaNote from "../components/MsaNote.astro";
import { FAQ_HOME } from "../lib/faq";
import { GROUPS } from "../lib/plans";
import { linkClass, planAnchor } from "../lib/links";
import { SITE } from "../lib/site";
---

<BaseLayout
  title={SITE.titleDefault}
  description={SITE.description}
  path="/"
  faq={FAQ_HOME}
>
  <section class="border-b border-zinc-800/80">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:py-16">
      <PlanSummary showImage />
    </div>
  </section>

  <section class="border-b border-zinc-800/80 bg-zinc-950/40" id="included">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
      <h2 class="text-xl font-semibold text-white">What is included</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {
          GROUPS.map((group) => (
            <article class="rounded-2xl border border-zinc-800 bg-zinc-950/50 p-5">
              <h3 class="text-base font-semibold text-white">
                <a href={planAnchor(group.id)} class="hover:text-gold">
                  {group.title}
                </a>
              </h3>
              <FeatureLines features={group.features} dense />
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80" id="price">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
      <h2 class="text-xl font-semibold text-white">Price</h2>
      <p class="mt-4 text-3xl font-semibold text-white">$569/mo</p>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-300">
        Setup is $500 one-time for a branded online storefront, or $2,500
        one-time for a full custom website. Details are on the plan page.
      </p>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-400">
        FFL Accelerator is a plan from Coriolis, LLC in Greenville, SC.
        <a class={linkClass} href="https://www.coriolisagency.com/about" target="_blank" rel="noopener">About Coriolis, LLC</a>
      </p>
    </div>
  </section>

  <FaqBlock items={FAQ_HOME} title="Questions we get" />
  <MsaNote />
</BaseLayout>
