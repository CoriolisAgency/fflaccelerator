---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import IncludedIndex from "../components/IncludedIndex.astro";
import PhotoBand from "../components/PhotoBand.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { FAQ_HOME } from "../lib/faq";
---

<BaseLayout
  title={undefined}
  description={undefined}
  path="/"
  faq={FAQ_HOME}
>
  <Hero
    image="photos/bench.jpg"
    alt="A wood bench, lit from the side"
    focus="64% 70%"
    primaryHref="#included"
    primaryLabel="See What's Included"
  />
  <IncludedIndex />
  <PhotoBand
    src="photos/shop.jpg"
    alt="A shop counter with people gathered around shipping boxes"
  />
  <FaqBlock items={FAQ_HOME} title="Questions we get" />
</BaseLayout>
