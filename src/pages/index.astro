---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaRow from "../components/CtaRow.astro";
import FaqBlock from "../components/FaqBlock.astro";
import { FAQ_HOME } from "../lib/faq";
import { LINKS, linkClass } from "../lib/links";
import { INCLUDED, SETUP, SWITCH_STEPS } from "../lib/plans";
import { CANON_PATHS } from "../lib/site";
import { withBase } from "../lib/base";
---

<BaseLayout
  title="FFL Accelerator — a gun store website you own | $569 a month"
  description="Coriolis builds and runs WooCommerce for gun stores. FFL checkout, distributor catalogs, and Betsy on your site. $569 a month. You leave with the website."
  path="/"
  faq={FAQ_HOME}
>
  <section class="border-b border-zinc-800/80">
    <div
      class="mx-auto grid max-w-7xl items-center gap-10 px-4 py-12 sm:px-6 lg:grid-cols-2 lg:py-16"
    >
      <div>
        <p
          class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold"
        >
          FFL Accelerator
        </p>
        <h1
          class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-5xl leading-[1.12]"
        >
          A gun store website you own
        </h1>
        <p class="mt-4 text-base leading-relaxed text-zinc-300 sm:text-lg">
          Most shops call a template platform a website. AmmoReady and Gearfire
          give you pages you don’t control — ads you can’t remove, titles and
          slugs you don’t write, the same HTML as every other dealer on that
          stack. Template-based websites kill SEO in the cradle. Coriolis builds
          WooCommerce on your domain. Sell what’s in the safe. Dropship from
          twenty-one distributors. Or both. That plan is FFL Accelerator.
        </p>
        <div class="mt-8">
          <CtaRow />
        </div>
      </div>
      <div class="relative">
        <img
          src={withBase(CANON_PATHS.sales)}
          alt="Add to cart on a gun store website"
          width="1024"
          height="683"
          class="w-full rounded-2xl object-cover ring-1 ring-white/10"
        />
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 bg-zinc-950/40" id="price">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
      <h2 class="text-xl font-semibold text-white">Price</h2>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-300">
        FFL Accelerator is $569 a month. Setup is $500 for a branded online
        storefront, or $2,500 for a full custom website and email. No year-long
        lock. If you leave, the website goes with you.
      </p>
      <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-400">
        See all plans (Minute Man through Accelerator) on{" "}
        <a
          href={LINKS.plans}
          class={linkClass}
          target="_blank"
          rel="noopener noreferrer">Coriolis FFL Ecommerce</a
        >.
      </p>
    </div>
  </section>

  <section class="border-b border-zinc-800/80" id="included">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
      <h2 class="text-xl font-semibold text-white">What’s included</h2>
      <ul class="mt-6 max-w-3xl space-y-2 text-sm leading-relaxed text-zinc-300">
        {INCLUDED.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="border-b border-zinc-800/80 bg-zinc-950/40" id="setup">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
      <h2 class="text-xl font-semibold text-white">
        FFL Website Setup Packages
      </h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {
          SETUP.map((s) => (
            <article class="flex flex-col rounded-2xl border border-zinc-800 bg-zinc-950/50 p-6">
              <p class="text-[11px] font-semibold uppercase tracking-[0.14em] text-zinc-500">
                {s.hook}
              </p>
              <h3 class="mt-2 text-lg font-semibold text-white">{s.name}</h3>
              <p class="mt-1 text-2xl font-semibold text-gold">
                ${s.price.toLocaleString()}
                <span class="text-sm font-medium text-zinc-500"> one-time</span>
              </p>
              <ul class="mt-4 flex-1 space-y-1.5 text-sm text-zinc-400">
                {s.features.map((f) => (
                  <li>{f}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-b border-zinc-800/80" id="replace-template-website">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
      <h2 class="text-xl font-semibold text-white">
        Replace a template website with one that works
      </h2>
      <div class="mt-4 max-w-3xl space-y-4 text-sm leading-relaxed text-zinc-300">
        <p>
          If your website is covered in ads you can’t remove, it’s not your
          website. On AmmoReady or Gearfire, inventory changes and the page does
          not. You don’t control title, slugs, or copy. Coriolis is not
          affiliated with Gearfire or RetailBI.
        </p>
        <p>Keep the register you already run. We replace the website.</p>
        <p>Switch, in order:</p>
      </div>
      <ol
        class="mt-4 max-w-3xl list-decimal space-y-2 pl-5 text-sm leading-relaxed text-zinc-400"
      >
        {SWITCH_STEPS.map((step) => <li>{step}</li>)}
      </ol>
      <div class="mt-8">
        <CtaRow />
      </div>
    </div>
  </section>

  <FaqBlock items={FAQ_HOME} title="Questions we get" />

  <section class="border-b border-zinc-800/80 py-8">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <p class="max-w-3xl text-sm leading-relaxed text-zinc-500">
        By subscribing to any plan or purchasing any setup package you are
        agreeing to the terms of our{" "}
        <a
          href={LINKS.msa}
          class={linkClass}
          target="_blank"
          rel="noopener noreferrer">Master Services Agreement</a
        >.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <p class="max-w-3xl text-sm leading-relaxed text-zinc-400">
        Our Founder and CEO is the guy that built and ran AmmoReady.com for 9
        years.
      </p>
    </div>
  </section>
</BaseLayout>
