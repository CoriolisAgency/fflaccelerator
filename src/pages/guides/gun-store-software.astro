---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaRow from "../../components/CtaRow.astro";
---

<BaseLayout
  title="FFL software is not one product | FFL Accelerator"
  description="Records, the register, and the website are different jobs. This site is the website."
  path="/guides/gun-store-software/"
>
  <article class="mx-auto max-w-3xl px-5 py-16 sm:px-8 lg:py-24">
    <p class="text-sm font-medium text-muted">Guide</p>
    <h1 class="type-display mt-3 text-5xl sm:text-6xl">
      FFL software is not one product
    </h1>
    <p class="mt-6 text-lg leading-relaxed">
      People search for the best FFL software and get three different jobs in
      one pile. Your bound book is not your website. Your register is not your
      website. FFL Accelerator is the website.
    </p>

    <h2 class="type-display mt-12 text-3xl">Three jobs</h2>
    <div class="mt-4">
      {
        [
          {
            t: "Records",
            d: "A&D book and Form 4473. Dedicated vendors and your counsel. Not us.",
          },
          {
            t: "The register",
            d: "The counter system you already run. That is sell-through. Keep it.",
          },
          {
            t: "The website",
            d: "The public store you own. WooCommerce, FFL checkout, optional distributor catalogs. That is FFL Accelerator.",
          },
        ].map((b) => (
          <section class="border-t border-line py-5">
            <h3 class="type-display text-2xl">{b.t}</h3>
            <p class="mt-2 max-w-xl">{b.d}</p>
          </section>
        ))
      }
    </div>

    <CtaRow />
  </article>
</BaseLayout>
