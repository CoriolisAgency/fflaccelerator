---
import { MARKETPLACE_NAMES } from "../lib/plans";

interface Props {
  /** "count" is one line and hides the names. "names" lists each marketplace as plain text. */
  mode?: "names" | "count";
}

const { mode = "count" } = Astro.props;
---

{
  mode === "count" ? (
    <p>Integrations with {MARKETPLACE_NAMES.length} online marketplaces</p>
  ) : (
    <div>
      <span>Marketplace Integrations:</span>
      <ul class="ticks mt-1">
        {MARKETPLACE_NAMES.map((name) => (
          <li>{name}</li>
        ))}
      </ul>
    </div>
  )
}
