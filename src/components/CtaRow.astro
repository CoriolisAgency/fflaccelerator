---
import { LINKS, btnPlan, btnSky, btnSecondary } from "../lib/links";

interface Props {
  primary?: "plans" | "gsa";
  showContact?: boolean;
  plansLabel?: string;
  gsaLabel?: string;
}

const {
  primary = "plans",
  showContact = true,
  plansLabel = "Get the $569 plan",
  gsaLabel = "Put Betsy on a site I already have",
} = Astro.props;
---

<div class="flex flex-col gap-2.5 sm:flex-row sm:flex-wrap">
  <a
    href={LINKS.plans}
    target="_blank"
    rel="noopener noreferrer"
    class={primary === "plans" ? btnPlan : btnSecondary}
  >
    {plansLabel}
  </a>
  <a
    href={LINKS.gsa}
    target="_blank"
    rel="noopener noreferrer"
    class={primary === "gsa" ? btnSky : btnSecondary}
  >
    {gsaLabel}
  </a>
  {
    showContact && (
      <a
        href={LINKS.contact}
        target="_blank"
        rel="noopener noreferrer"
        class={btnSecondary}
      >
        Talk to Coriolis
      </a>
    )
  }
</div>
