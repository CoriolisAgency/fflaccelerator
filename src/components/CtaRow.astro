---
import { LINKS, btnPlan, btnSecondary } from "../lib/links";

interface Props {
  primary?: "plans" | "contact" | "gsa";
  showGsa?: boolean;
  showContact?: boolean;
  plansLabel?: string;
  gsaLabel?: string;
}

const {
  primary = "plans",
  showGsa = true,
  showContact = true,
  plansLabel = "FFL Accelerator — $569/mo",
  gsaLabel = "Free GunSearchAgent",
} = Astro.props;
---

<div class="flex flex-col gap-2.5 sm:flex-row sm:flex-wrap">
  <a
    href={LINKS.plans}
    target="_blank"
    rel="noopener noreferrer"
    class={primary === "plans" ? btnPlan : btnSecondary}
  >
    {plansLabel}
  </a>
  {
    showContact && (
      <a
        href={LINKS.contact}
        target="_blank"
        rel="noopener noreferrer"
        class={primary === "contact" ? btnPlan : btnSecondary}
      >
        Contact Coriolis
      </a>
    )
  }
  {
    showGsa && (
      <a
        href={LINKS.gsa}
        target="_blank"
        rel="noopener noreferrer"
        class={primary === "gsa" ? btnPlan : btnSecondary}
      >
        {gsaLabel}
      </a>
    )
  }
</div>
