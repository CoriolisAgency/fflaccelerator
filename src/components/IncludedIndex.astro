---
import FeatureLines from "./FeatureLines.astro";
import { GROUPS } from "../lib/plans";
import { planAnchor } from "../lib/links";
import { withBase } from "../lib/base";
---

<section id="included" class="mx-auto max-w-7xl px-5 py-16 sm:px-8 lg:py-24">
  <h2 class="type-display text-4xl text-ink sm:text-5xl">What is included</h2>
  <div class="feature-cards">
    {
      GROUPS.map((group) => (
        <article class="feature-card">
          <h3 class="type-display text-2xl">
            <a
              href={planAnchor(group.id)}
              class="underline decoration-transparent underline-offset-4 hover:decoration-ink"
            >
              {group.title}
            </a>
          </h3>
          <div class="feature-card__body">
            <FeatureLines features={group.features} />
          </div>
        </article>
      ))
    }
  </div>
  <p class="feature-cards__note text-sm leading-relaxed text-muted">
    FFL Accelerator is a plan from Coriolis, LLC in Greenville, SC.
    <a
      href={withBase("about")}
      class="text-ink underline decoration-line underline-offset-4 hover:decoration-ink"
>About Coriolis, LLC</a
    >
  </p>
</section>
