---
import FeatureLines from "./FeatureLines.astro";
import { GROUPS } from "../lib/plans";
import { planAnchor } from "../lib/links";
---

<section
  id="included"
  class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-8 lg:grid-cols-12 lg:gap-16 lg:py-24"
>
  <div class="lg:col-span-4">
    <h2 class="type-display text-4xl text-ink sm:text-5xl lg:sticky lg:top-24">
      What is included
    </h2>
  </div>
  <div class="lg:col-span-8">
    {
      GROUPS.map((group) => (
        <article class="grid gap-3 border-t border-line py-7 sm:grid-cols-12 sm:gap-6">
          <div class="sm:col-span-5">
            <h3 class="type-display text-2xl">
              <a
                href={planAnchor(group.id)}
                class="underline decoration-transparent underline-offset-4 hover:decoration-ink"
              >
                {group.title}
              </a>
            </h3>
          </div>
          <div class="sm:col-span-7">
            <FeatureLines features={group.features} />
          </div>
        </article>
      ))
    }
    <p class="border-t border-line pt-7 text-sm leading-relaxed text-muted">
      FFL Accelerator is a plan from Coriolis, LLC in Greenville, SC.
      <a
        href="https://www.coriolisagency.com/about"
        class="text-ink underline decoration-line underline-offset-4 hover:decoration-ink"
        target="_blank"
        rel="noopener">About Coriolis, LLC</a
      >
    </p>
  </div>
</section>
