---
import type { FaqItem } from "../lib/faq";

interface Props {
  items: FaqItem[];
  title?: string;
}

const { items, title = "Questions we get" } = Astro.props;
---

<section class="border-t border-line">
  <div
    class="mx-auto grid max-w-7xl gap-10 px-5 py-16 sm:px-8 lg:grid-cols-12 lg:py-24"
  >
    <h2 class="type-display text-4xl text-ink sm:text-5xl lg:col-span-4">
      {title}
    </h2>
    <dl class="lg:col-span-8">
      {
        items.map((item) => (
          <div class="border-t border-line py-6">
            <dt class="type-display text-2xl text-ink">{item.q}</dt>
            <dd class="mt-3 max-w-2xl text-base leading-relaxed text-ink">{item.a}</dd>
          </div>
        ))
      }
    </dl>
  </div>
  <p class="mx-auto max-w-7xl px-5 pb-16 text-sm text-muted sm:px-8">
    Master Services Agreement provided at signup.
  </p>
</section>
