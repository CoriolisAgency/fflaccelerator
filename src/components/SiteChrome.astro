---
import { PATHS } from "../lib/links";
import { CANON_PATHS as CANON, FOOTER_IDENTITY, SITE, TRADEMARK_LINE } from "../lib/site";
import { withBase } from "../lib/base";

interface Props {
  /** Hide nav and site links. Used for the Meta ad landing. */
  adLanding?: boolean;
}

const { adLanding = false } = Astro.props;

const base = import.meta.env.BASE_URL || "/";
const rawPath = Astro.url.pathname;
const path =
  (rawPath.startsWith(base) ? rawPath.slice(base.length - 1) : rawPath).replace(
    /\/$/,
    "",
  ) || "/";

const nav = [
  { href: "plan", label: "Plan" },
  { href: "about", label: "About" },
] as const;

function active(slug: string) {
  const p = `/${slug}`;
  return path === p || path.startsWith(p + "/");
}

const onCampaignDoor = path === "/" || path === "/plan";
const phoneAt = FOOTER_IDENTITY.lastIndexOf(SITE.phone);
const footerBeforePhone = FOOTER_IDENTITY.slice(0, phoneAt);
const siteNav = [
  { href: withBase("plan"), label: "Plan" },
  { href: withBase("about"), label: "About" },
  { href: withBase("guides/gun-store-software"), label: "FFL Software" },
  { href: withBase(PATHS.contact), label: "Contact" },
  { href: withBase(PATHS.privacy), label: "Privacy" },
].filter((item) => {
  if (!onCampaignDoor) return true;
  return !item.href.includes("/guides/");
});
---

<div class="site-frame">
<header class="sticky top-0 z-40 border-b-2 border-gold bg-field">
  <div
    class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-4 gap-y-2 px-5 py-3 sm:px-8"
  >
    {
      adLanding ? (
        <span class="shrink-0">
          <img
            src={withBase(CANON.logo)}
            alt="FFL Accelerator"
            width="437"
            height="163"
            class="h-8 w-auto sm:h-10"
          />
        </span>
      ) : (
        <a href={withBase("/")} class="shrink-0" aria-label="FFL Accelerator">
          <img
            src={withBase(CANON.logo)}
            alt=""
            width="437"
            height="163"
            class="h-8 w-auto sm:h-10"
          />
        </a>
      )
    }
    {
      !adLanding && (
        <nav
          class="flex flex-wrap items-center justify-end gap-x-4 gap-y-2 sm:gap-x-6"
          aria-label="Main"
        >
          {nav.map((item) => (
            <a
              href={withBase(item.href)}
              class:list={[
                "text-sm font-medium",
                active(item.href) ? "text-paper" : "text-fog hover:text-paper",
              ]}
            >
              {item.label}
            </a>
          ))}
          <a
            href={withBase(PATHS.contact)}
            class="inline-flex min-h-11 items-center bg-gold px-3 text-sm font-semibold text-ink transition-colors duration-150 hover:bg-paper sm:px-4"
          >
            Learn More
          </a>
        </nav>
      )
    }
  </div>
</header>

<main class="flex-1">
  <slot />
</main>

<footer class="bg-field text-fog">
  <div class="mx-auto max-w-7xl px-5 py-12 sm:px-8">
    <img
      src={withBase(CANON.logo)}
      alt=""
      width="437"
      height="163"
      class="h-8 w-auto"
    />
    <p class="mt-6 text-sm text-paper">
      {footerBeforePhone}<a
        class="underline decoration-white/30 underline-offset-4 hover:decoration-gold"
        href={SITE.phoneHref}>{SITE.phone}</a
      >
    </p>
    <p class="mt-4 max-w-3xl text-xs leading-relaxed text-fog">{TRADEMARK_LINE}</p>
    {
      !adLanding ? (
        <nav
          class="mt-8 flex flex-wrap gap-x-5 gap-y-2 text-sm"
          aria-label="Footer"
        >
          {siteNav.map((item) => (
            <a href={item.href} class="text-fog hover:text-paper">
              {item.label}
            </a>
          ))}
        </nav>
      ) : (
        <p class="mt-8 text-sm">
          <a
            href={withBase(PATHS.privacy)}
            class="text-fog hover:text-paper"
          >
            Privacy
          </a>
        </p>
      )
    }
  </div>
</footer>
</div>
