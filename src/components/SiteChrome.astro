---
import { LINKS } from "../lib/links";
import { CANON_PATHS as CANON } from "../lib/site";
import { withBase } from "../lib/base";

const base = import.meta.env.BASE_URL || "/";
const rawPath = Astro.url.pathname;
const path =
  (rawPath.startsWith(base)
    ? rawPath.slice(base.length - 1)
    : rawPath
  ).replace(/\/$/, "") || "/";

const nav = [
  { href: "plan", label: "Plan" },
  { href: "gunsearchagent-included", label: "Betsy on the shop" },
  { href: "about", label: "About" },
] as const;

function active(slug: string) {
  const p = `/${slug}`;
  return path === p || path.startsWith(p + "/");
}

const siteNav = [
  { href: withBase("plan"), label: "Plan", external: false },
  { href: withBase("about"), label: "About", external: false },
  {
    href: withBase("gunsearchagent-included"),
    label: "Betsy on the shop",
    external: false,
  },
  {
    href: withBase("guides/gun-store-software"),
    label: "Gun store software",
    external: false,
  },
] as const;
---

<header
  class="sticky top-0 z-40 border-b border-zinc-800/80 bg-[color-mix(in_srgb,#0a1220_94%,transparent)] backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6"
  >
    <a href={withBase("/")} class="shrink-0">
      <img
        src={withBase(CANON.logo)}
        alt="FFL Accelerator"
        width="500"
        height="200"
        class="h-10 w-auto sm:h-12"
      />
    </a>
    <nav
      class="flex flex-wrap items-center justify-end gap-1 sm:gap-1.5"
      aria-label="Main"
    >
      {
        nav.map((item) => (
          <a
            href={withBase(item.href)}
            class:list={[
              "rounded-sm border px-2.5 py-1.5 text-xs font-medium transition-colors sm:text-sm",
              active(item.href)
                ? "border-gold/50 bg-gold/10 text-gold"
                : "border-zinc-700 text-zinc-200 hover:bg-zinc-800",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={LINKS.plans}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-sm border border-gold/70 bg-gold px-2.5 py-1.5 text-xs font-semibold text-ink hover:bg-amber-300 sm:text-sm"
      >
        Start FFL Accelerator
      </a>
    </nav>
  </div>
</header>

<main class="flex-1">
  <slot />
</main>

<footer class="border-t border-zinc-800/80 bg-[#070b12]">
  <div
    class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-10 sm:px-6 lg:flex-row lg:items-start lg:justify-between"
  >
    <div class="space-y-3 max-w-md">
      <img
        src={withBase(CANON.logo)}
        alt="FFL Accelerator"
        width="500"
        height="200"
        class="h-9 w-auto"
      />
      <p class="text-sm text-zinc-400">A gun store website you own</p>
      <p class="text-xs leading-relaxed text-zinc-500">
        Coriolis, LLC. Greenville, SC. This is a Coriolis program, not a second
        company.
      </p>
    </div>
    <nav
      class="flex flex-wrap gap-x-4 gap-y-2 text-xs text-zinc-400"
      aria-label="Site"
    >
      {
        siteNav.map((item) => (
          <a
            href={item.href}
            class="hover:text-gold"
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noopener noreferrer" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
  <p class="px-4 pb-6 text-center text-[11px] text-zinc-600">
    Not affiliated with Gearfire or RetailBI. We are not 4473 software and not a
    register.
  </p>
</footer>
