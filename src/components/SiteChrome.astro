---
import { LINKS } from "../lib/links";
import { CANON_PATHS as CANON } from "../lib/site";
import { withBase } from "../lib/base";

const base = import.meta.env.BASE_URL || "/";
const rawPath = Astro.url.pathname;
const path =
  (rawPath.startsWith(base)
    ? rawPath.slice(base.length - 1)
    : rawPath
  ).replace(/\/$/, "") || "/";

const nav = [
  { href: "plan", label: "Plan" },
  { href: "switch", label: "Switch" },
  { href: "ffl-ecommerce", label: "Ecommerce" },
  { href: "ffl-dropshipping", label: "Dropshipping" },
  { href: "gunsearchagent-included", label: "GSA" },
  { href: "retailbi-and-axis", label: "AXIS" },
  { href: "about", label: "About" },
] as const;

function active(slug: string) {
  const p = `/${slug}`;
  return path === p || path.startsWith(p + "/");
}
---

<header
  class="sticky top-0 z-40 border-b border-zinc-800/80 bg-[color-mix(in_srgb,#0a1220_92%,transparent)] backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-4 py-3"
  >
    <div class="flex items-center gap-2.5 min-w-0">
      <a
        href={LINKS.betsy}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0"
      >
        <img
          src={withBase(CANON.headshot)}
          alt="Betsy AI"
          width="36"
          height="36"
          class="h-9 w-9 rounded-xl object-cover ring-1 ring-sky-500/40 shadow-md shadow-sky-500/20"
        />
      </a>
      <a href={withBase("/")} class="min-w-0 group">
        <span
          class="block text-sm font-semibold tracking-wide text-white group-hover:text-sky-100"
          >FFL Accelerator</span
        >
        <span class="block text-[11px] italic text-zinc-500"
          >Your site. Betsy included.</span
        >
      </a>
    </div>
    <nav
      class="flex flex-wrap items-center justify-end gap-1 sm:gap-1.5"
      aria-label="Main"
    >
      {
        nav.map((item) => (
          <a
            href={withBase(item.href)}
            class:list={[
              "rounded-lg border px-2.5 py-1.5 text-xs font-medium transition-colors",
              active(item.href)
                ? "border-sky-500/50 bg-sky-500/15 text-sky-200"
                : "border-zinc-700 text-zinc-200 hover:bg-zinc-800",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={LINKS.plans}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-lg border border-emerald-500/35 bg-emerald-500/10 px-2.5 py-1.5 text-xs font-medium text-emerald-200 hover:bg-emerald-500/20"
      >
        $569/mo
      </a>
    </nav>
  </div>
</header>

<main class="flex-1">
  <slot />
</main>

<footer class="border-t border-zinc-800/80 bg-[#0a1220]">
  <div
    class="mx-auto flex max-w-6xl flex-col gap-4 px-4 py-8 text-sm text-zinc-400 sm:flex-row sm:items-start sm:justify-between"
  >
    <div class="space-y-1 max-w-sm">
      <p class="font-medium text-zinc-200">FFL Accelerator</p>
      <p class="text-xs leading-relaxed">
        A Coriolis, LLC program — not a separate company. Greenville, SC.
      </p>
    </div>
    <nav class="flex flex-wrap gap-x-4 gap-y-2 text-xs" aria-label="Family">
      <a href={withBase("ffl-ecommerce")} class="hover:text-sky-300"
        >FFL ecommerce</a
      >
      <a href={withBase("switch")} class="hover:text-sky-300">Switch</a>
      <a href={withBase("gunsearchagent-included")} class="hover:text-sky-300"
        >GSA included</a
      >
      <a href={withBase("retailbi-and-axis")} class="hover:text-sky-300"
        >RetailBI &amp; AXIS</a
      >
      <a
        href={LINKS.gsa}
        class="hover:text-sky-300"
        target="_blank"
        rel="noopener noreferrer">GunSearchAgent</a
      >
      <a
        href={LINKS.fflintel}
        class="hover:text-sky-300"
        target="_blank"
        rel="noopener noreferrer">FFLIntel</a
      >
      <a
        href={LINKS.plans}
        class="hover:text-emerald-300"
        target="_blank"
        rel="noopener noreferrer">Coriolis plans</a
      >
    </nav>
  </div>
  <p class="px-4 pb-6 text-center text-[11px] text-zinc-600">
    Not affiliated with Gearfire or RetailBI. Not 4473/ATF software. Not a POS.
    Marks belong to their owners.
  </p>
</footer>
