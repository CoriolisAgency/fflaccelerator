---
import { LINKS } from "../lib/links";
import { CANON_PATHS as CANON } from "../lib/site";
import { withBase } from "../lib/base";

const base = import.meta.env.BASE_URL || "/";
const rawPath = Astro.url.pathname;
const path =
  (rawPath.startsWith(base)
    ? rawPath.slice(base.length - 1)
    : rawPath
  ).replace(/\/$/, "") || "/";

const nav = [
  { href: "plan", label: "Plan" },
  { href: "gunsearchagent-included", label: "Betsy included" },
  { href: "retailbi-and-axis", label: "RetailBI" },
  { href: "switch", label: "Switch" },
  { href: "ffl-ecommerce", label: "Ecommerce" },
  { href: "about", label: "About" },
] as const;

function active(slug: string) {
  const p = `/${slug}`;
  return path === p || path.startsWith(p + "/");
}

const family = [
  { href: LINKS.plans, label: "Coriolis plans" },
  { href: LINKS.gsa, label: "GunSearchAgent" },
  { href: LINKS.gsaGa, label: "GA for FFLs" },
  { href: LINKS.gsaRetailBi, label: "RetailBI and your store" },
  { href: LINKS.betsyVsRetailBi, label: "What is RetailBI" },
  { href: LINKS.retailBiIndex, label: "Firearm Sales Index" },
  { href: LINKS.nicsVsSales, label: "NICS vs sales" },
  { href: LINKS.demandIntel, label: "Demand Intelligence" },
  { href: LINKS.fflintel, label: "FFLIntel" },
  { href: LINKS.betsy, label: "2aBetsy" },
] as const;
---

<header
  class="sticky top-0 z-40 border-b border-zinc-800/80 bg-[color-mix(in_srgb,#0a1220_94%,transparent)] backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6"
  >
    <a href={withBase("/")} class="shrink-0">
      <img
        src={withBase(CANON.logo)}
        alt="FFL Accelerator"
        width="500"
        height="200"
        class="h-10 w-auto sm:h-12"
      />
    </a>
    <nav
      class="flex flex-wrap items-center justify-end gap-1 sm:gap-1.5"
      aria-label="Main"
    >
      {
        nav.map((item) => (
          <a
            href={withBase(item.href)}
            class:list={[
              "rounded-sm border px-2.5 py-1.5 text-xs font-medium transition-colors sm:text-sm",
              active(item.href)
                ? "border-gold/50 bg-gold/10 text-gold"
                : "border-zinc-700 text-zinc-200 hover:bg-zinc-800",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={LINKS.plans}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-sm border border-gold/70 bg-gold px-2.5 py-1.5 text-xs font-semibold text-ink hover:bg-amber-300 sm:text-sm"
      >
        $569/mo
      </a>
    </nav>
  </div>
</header>

<main class="flex-1">
  <slot />
</main>

<footer class="border-t border-zinc-800/80 bg-[#070b12]">
  <div
    class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-10 sm:px-6 lg:flex-row lg:items-start lg:justify-between"
  >
    <div class="space-y-3 max-w-md">
      <img
        src={withBase(CANON.logo)}
        alt="FFL Accelerator"
        width="500"
        height="200"
        class="h-9 w-auto"
      />
      <p class="text-sm text-zinc-400">Your site. Betsy included.</p>
      <p class="text-xs leading-relaxed text-zinc-500">
        A Coriolis, LLC program — not a separate company. Greenville, SC.
        Checkout is on Coriolis. GunSearchAgent is free if you already have a
        site.
      </p>
    </div>
    <nav
      class="flex flex-wrap gap-x-4 gap-y-2 text-xs text-zinc-400"
      aria-label="Family"
    >
      {
        family.map((item) => (
          <a
            href={item.href}
            class="hover:text-sky-300"
            target="_blank"
            rel="noopener noreferrer"
          >
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
  <p class="px-4 pb-6 text-center text-[11px] text-zinc-600">
    Not affiliated with Gearfire or RetailBI. Not 4473/ATF software. Not a POS.
    Marks belong to their owners.
  </p>
</footer>
