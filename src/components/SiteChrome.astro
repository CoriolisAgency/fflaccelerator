---
import { PATHS } from "../lib/links";
import { CANON_PATHS as CANON, FOOTER_IDENTITY, SITE, TRADEMARK_LINE } from "../lib/site";
import { withBase } from "../lib/base";

interface Props {
  /** Hide nav and site links. Used for the Meta ad landing. */
  adLanding?: boolean;
}

const { adLanding = false } = Astro.props;

const base = import.meta.env.BASE_URL || "/";
const rawPath = Astro.url.pathname;
const path =
  (rawPath.startsWith(base) ? rawPath.slice(base.length - 1) : rawPath).replace(
    /\/$/,
    "",
  ) || "/";

const nav = [
  { href: "plan", label: "Plan" },
  { href: "about", label: "About" },
] as const;

function active(slug: string) {
  const p = `/${slug}`;
  return path === p || path.startsWith(p + "/");
}

const onCampaignDoor = path === "/" || path === "/plan";
const phoneAt = FOOTER_IDENTITY.lastIndexOf(SITE.phone);
const footerBeforePhone = FOOTER_IDENTITY.slice(0, phoneAt);
const siteNav = [
  { href: withBase("plan"), label: "Plan" },
  { href: withBase("about"), label: "About" },
  { href: withBase("guides/gun-store-software"), label: "Store software" },
  { href: withBase(PATHS.contact), label: "Contact" },
  { href: withBase(PATHS.privacy), label: "Privacy" },
].filter((item) => {
  if (!onCampaignDoor) return true;
  return !item.href.includes("/guides/");
});
---

<header
  class="sticky top-0 z-40 border-b border-zinc-800/80 bg-[color-mix(in_srgb,#0a1220_94%,transparent)] backdrop-blur-md"
>
  <div
    class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-4 sm:px-6"
  >
    {
      adLanding ? (
        <span class="shrink-0">
          <img
            src={withBase(CANON.logo)}
            alt="FFL Accelerator"
            width="500"
            height="200"
            class="h-10 w-auto sm:h-12"
          />
        </span>
      ) : (
        <a href={withBase("/")} class="shrink-0">
          <img
            src={withBase(CANON.logo)}
            alt="FFL Accelerator"
            width="500"
            height="200"
            class="h-10 w-auto sm:h-12"
          />
        </a>
      )
    }
    {
      !adLanding && (
        <nav
          class="flex flex-wrap items-center justify-end gap-1 sm:gap-1.5"
          aria-label="Main"
        >
          {nav.map((item) => (
            <a
              href={withBase(item.href)}
              class:list={[
                "rounded-sm border px-2.5 py-1.5 text-xs font-medium transition-colors sm:text-sm",
                active(item.href)
                  ? "border-gold/50 bg-gold/10 text-gold"
                  : "border-zinc-700 text-zinc-200 hover:bg-zinc-800",
              ]}
            >
              {item.label}
            </a>
          ))}
          <a
            href={withBase(PATHS.contact)}
            class="rounded-sm border border-gold/70 bg-gold px-2.5 py-1.5 text-xs font-semibold text-ink hover:bg-amber-300 sm:text-sm"
          >
            Start FFL Accelerator
          </a>
        </nav>
      )
    }
  </div>
</header>

<main class="flex-1">
  <slot />
</main>

<footer class="border-t border-zinc-800/80 bg-[#070b12]">
  <div
    class="mx-auto flex max-w-7xl flex-col gap-6 px-4 py-10 sm:px-6 lg:flex-row lg:items-start lg:justify-between"
  >
    <div class="max-w-md space-y-3">
      <img
        src={withBase(CANON.logo)}
        alt="FFL Accelerator"
        width="500"
        height="200"
        class="h-9 w-auto"
      />
      <p class="text-sm leading-relaxed text-zinc-300">
        {footerBeforePhone}<a class="hover:text-gold" href={SITE.phoneHref}>{SITE.phone}</a>
      </p>
      <p class="text-xs leading-relaxed text-zinc-500">{TRADEMARK_LINE}</p>
    </div>
    {
      !adLanding ? (
        <nav
          class="flex flex-wrap gap-x-4 gap-y-2 text-xs text-zinc-400"
          aria-label="Site"
        >
          {siteNav.map((item) => (
            <a href={item.href} class="hover:text-gold">
              {item.label}
            </a>
          ))}
        </nav>
      ) : (
        <p class="text-xs text-zinc-400">
          <a href={withBase(PATHS.privacy)} class="hover:text-gold">
            Privacy
          </a>
        </p>
      )
    }
  </div>
</footer>
