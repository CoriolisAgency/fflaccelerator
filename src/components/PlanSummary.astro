---
import CtaRow from "./CtaRow.astro";
import { PLAN } from "../lib/plans";
import { CANON_PATHS } from "../lib/site";
import { withBase } from "../lib/base";

interface Props {
  heading?: "h1" | "h2";
  showImage?: boolean;
}

const { heading = "h1", showImage = false } = Astro.props;
const Title = heading;
---

<div class:list={[showImage && "grid items-center gap-10 lg:grid-cols-2"]}>
  <div>
    <p class="text-[11px] font-semibold uppercase tracking-[0.18em] text-gold">
      {PLAN.eyebrow}
    </p>
    <Title
      class="mt-3 text-3xl font-semibold tracking-tight text-white sm:text-5xl leading-[1.12]"
    >
      {PLAN.name}
    </Title>
    <p class="mt-4">
      <span
        class="inline-flex rounded-full border border-gold/50 bg-gold/10 px-2.5 py-0.5 text-[11px] font-semibold uppercase tracking-[0.14em] text-gold"
      >
        {PLAN.badge}
      </span>
    </p>
    <p class="mt-4 text-3xl font-semibold tracking-tight text-white">
      {PLAN.priceLabel}
    </p>
    <p class="mt-4 max-w-3xl text-base leading-relaxed text-zinc-300">
      {PLAN.description}
    </p>
    <p class="mt-4 max-w-3xl text-sm leading-relaxed text-zinc-400">
      {PLAN.includes}
    </p>
    <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-400">
      The site is yours.
    </p>
    <div class="mt-8">
      <CtaRow />
    </div>
  </div>
  {
    showImage && (
      <img
        src={withBase(CANON_PATHS.sales)}
        alt="Add to cart on a gun store website"
        width="1024"
        height="683"
        class="w-full rounded-2xl object-cover ring-1 ring-white/10"
      />
    )
  }
</div>
