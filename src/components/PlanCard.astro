---
import type { Plan } from "../lib/plans";
import { LINKS, btnPlan, btnSecondary } from "../lib/links";

interface Props {
  plan: Plan;
}

const { plan } = Astro.props;
---

<article
  class:list={[
    "relative flex flex-col rounded-2xl border p-5 sm:p-6",
    plan.featured
      ? "border-emerald-500/40 bg-emerald-500/10 shadow-lg shadow-emerald-950/30"
      : "border-zinc-800 bg-zinc-950/50",
  ]}
>
  {
    plan.featured && (
      <span class="absolute -top-2.5 right-4 rounded-full border border-emerald-500/40 bg-emerald-500/20 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-emerald-100">
        This plan
      </span>
    )
  }
  <p class="text-[11px] font-semibold uppercase tracking-[0.16em] text-sky-400">
    {plan.hook}
  </p>
  <h3 class="mt-1 text-xl font-semibold text-white">{plan.name}</h3>
  <p class="mt-3 flex items-baseline gap-1">
    <span class="text-3xl font-semibold tracking-tight text-white"
      >${plan.price}</span
    >
    <span class="text-sm text-zinc-500">/mo</span>
  </p>
  {
    plan.includesFrom && (
      <p class="mt-2 text-xs text-zinc-500">
        Everything in {plan.includesFrom}, plus:
      </p>
    )
  }
  <ul class="mt-4 flex-1 space-y-2 text-sm text-zinc-400">
    {
      plan.features.map((f) => (
        <li class="flex gap-2">
          <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-sky-500" />
          <span>{f}</span>
        </li>
      ))
    }
  </ul>
  <a
    href={LINKS.plans}
    target="_blank"
    rel="noopener noreferrer"
    class:list={["mt-6", plan.featured ? btnPlan : btnSecondary]}
  >
    {plan.featured ? "Get FFL Accelerator →" : "See on Coriolis →"}
  </a>
</article>
