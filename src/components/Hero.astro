---
import CtaRow from "./CtaRow.astro";
import { PLAN } from "../lib/plans";
import { withBase } from "../lib/base";

interface Props {
  image: string;
  alt: string;
  focus?: string;
  primaryHref?: string;
  primaryLabel?: string;
}

const {
  image,
  alt,
  focus = "center 62%",
  primaryHref,
  primaryLabel,
} = Astro.props;
---

<section class="hero-grid border-b border-line">
  <div
    class="flex flex-col justify-center px-5 py-12 sm:px-8 sm:py-16 lg:py-20 lg:pr-16 lg:pl-12 xl:pl-16"
  >
    <p class="flex items-center gap-3 text-sm font-medium text-ink">
      <span class="h-px w-8 bg-gold" aria-hidden="true"></span>
      {PLAN.eyebrow}
    </p>
    <h1 class="type-display hero-title mt-5 text-ink">{PLAN.name}</h1>
    <p class="mt-5 text-sm font-medium tracking-wide text-muted">{PLAN.badge}</p>
    <p class="mt-6 max-w-xl text-base leading-relaxed text-ink sm:text-lg">
      {PLAN.description}
    </p>
    <p class="mt-4 max-w-xl text-base leading-relaxed text-muted">{PLAN.stack}</p>
    <p class="type-pull mt-8 max-w-xl text-2xl text-ink sm:text-3xl">{PLAN.pull}</p>
    <CtaRow primaryHref={primaryHref} primaryLabel={primaryLabel} />
  </div>
  <div class="hero-photo">
    <img
      src={withBase(image)}
      alt={alt}
      style={`object-position: ${focus}`}
      class="absolute inset-0 h-full w-full object-cover"
    />
  </div>
</section>
