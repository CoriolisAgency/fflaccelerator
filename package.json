{
  "name": "fflaccelerator",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node --experimental-strip-types scripts/gen-vercel-redirects.mjs --check && astro build && node scripts/check-plan-copy.mjs && node scripts/check-social-meta.mjs && node scripts/check-ad-copy.mjs && node scripts/check-banned-links.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "gen:vercel": "node --experimental-strip-types scripts/gen-vercel-redirects.mjs",
    "check:links": "node scripts/check-banned-links.mjs",
    "test:handlers": "node --experimental-strip-types scripts/check-handlers.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@coriolis/lead-form": "git+https://github.com/CoriolisAgency/lead-form.git#v0.1.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.0",
    "tailwindcss": "^4.3.3"
  }
}
